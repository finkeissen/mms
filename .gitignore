# ==================================================
# OS / Editor
# ==================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ==================================================
# Python / Runtime
# ==================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/

# ==================================================
# Logs / Temp / Cache
# ==================================================
*.log
*.tmp
tmp/
temp/
.cache/
.cache/**

# ==================================================
# Repo policy:
# Implementation is NOT public
# ==================================================

# Gateway (implementation, runtime, experiments)
gateway/

# Implementation self-descriptions (belong to implementation, not requirements)
implementation.yaml

# ==================================================
# Requirements: generated or local artifacts only
# (normative markdown, schemas, contracts stay tracked)
# ==================================================
requirements/**/__pycache__/
requirements/**/tmp/
requirements/**/exports/
requirements/**/logs/

# ==================================================
# Optional safety net
# ==================================================
# Prevent accidental commits of large data or mirrors
*.jsonl
*.parquet
*.sqlite

dir.txt

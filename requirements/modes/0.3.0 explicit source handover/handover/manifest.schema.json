{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMS Handover Manifest",
  "type": "object",
  "required": ["handover_version", "source", "source_version", "artifacts", "assumptions", "limits"],
  "properties": {
    "handover_version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "source": { "type": "string" },
    "source_version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "type"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "stop_conditions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

